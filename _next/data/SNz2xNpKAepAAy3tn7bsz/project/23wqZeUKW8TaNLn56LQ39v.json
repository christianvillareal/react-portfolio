{"pageProps":{"project":{"id":"23wqZeUKW8TaNLn56LQ39v","title":"Whoobi App Design","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The application matrix represents an advanced ","marks":[],"data":{}},{"nodeType":"text","value":"B2B Growth Marketing & Artificial Intelligence Optimization Ecosystem","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" built explicitly for mobile-first entrepreneurs, growth hackers, and media buyers. The application functions as an all-in-one portable command center, bridging deep AI-driven digital asset generation with automated advertising analytics, lead acquisition, and social platform management.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The flow architecture transitions seamlessly from standard validation screens to deep analytical dashboards, grouped into distinct functional blocks:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Onboarding Gateways:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Comprising the dynamic launch splash (","marks":[],"data":{}},{"nodeType":"text","value":"Whoobi-Flash-Screen","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":"), a minimalist entry panel (","marks":[],"data":{}},{"nodeType":"text","value":"Landing","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":"), and traditional input portals (","marks":[],"data":{}},{"nodeType":"text","value":"Login","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Sign Up","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":").","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Creative & AI Core:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Houses a direct interaction canvas (","marks":[],"data":{}},{"nodeType":"text","value":"Ai Assistant","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":") and multi-tiered menu matrices (","marks":[],"data":{}},{"nodeType":"text","value":"Artificial Intelligence","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Banners","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":") for on-the-fly marketing asset production.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Campaign Analytics Dashboards:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Delivers high-density quantitative feedback structures (","marks":[],"data":{}},{"nodeType":"text","value":"Ads","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Main","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Main 2","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Leads","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Press","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":").","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Community Performance Feed:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Focuses on brand performance tracking and influence benchmarking (","marks":[],"data":{}},{"nodeType":"text","value":"Social","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Social Rankings","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":").","marks":[],"data":{}}]}]}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"🎯 Challenge & Strategy","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The critical design challenge of this suite was managing ","marks":[],"data":{}},{"nodeType":"text","value":"cognitive friction and data density","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":". Growth marketing interfaces frequently suffer from massive information overload, forcing users to navigate endless rows of tables, numbers, and toggle switches. On a small mobile screen, this data can easily become unreadable.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To counteract this, the interface deploys a ","marks":[],"data":{}},{"nodeType":"text","value":"\"Unambiguous Module Isolation & Micro-Action\"","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" layout strategy across its component arrays:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Standardized Analytic Anchors:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Across multiple main tracking screens (","marks":[],"data":{}},{"nodeType":"text","value":"Ads","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Leads","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Press","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":"), the design locks a bold, ultra-high-contrast numeric counter container (","marks":[],"data":{}},{"nodeType":"text","value":"232","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":") immediately above three color-coded action blocks (Green ","marks":[],"data":{}},{"nodeType":"text","value":"2","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", Gold ","marks":[],"data":{}},{"nodeType":"text","value":"3","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", Blue ","marks":[],"data":{}},{"nodeType":"text","value":"4","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":"). This recurring geometry allows users to switch between entirely separate tracking categories without needing to relearn the visual landscape.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Tactile Social Network Triggers:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" In the configuration modules (","marks":[],"data":{}},{"nodeType":"text","value":"Main","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":", ","marks":[],"data":{}},{"nodeType":"text","value":"Main 2","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":"), the application abandons nested multi-level text links in favor of an easily scannable grid of official social app icons. This layout quickly maps intricate multichannel synchronization workflows into a series of single-tap toggle commands.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Contextual Identity Separation:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" The onboarding matrix leverages high-contrast linear forms to simplify data collection, utilizing quick social-auth bridges (","marks":[],"data":{}},{"nodeType":"text","value":"Facebook, Google, Apple","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":") to reduce entry drop-off rates. This system is capped off by an explicit user segmentation path highlighted in the initial onboarding module (","marks":[],"data":{}},{"nodeType":"text","value":"Who Do You Want To Be?","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":").","marks":[],"data":{}}]}]}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"🎨 Design & Art Direction","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"✅ Ultra-Sleek Neon Dark Mode Palette","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The app's style is anchored by a deep black aesthetic, minimizing eye strain for power users during extended optimization sessions. Important buttons and text headers are highlighted with vibrant, high-saturation gradients that blend from electric blue to bright magenta. This vivid color scheme is balanced by crisp, clear secondary indicator backgrounds in neon green, amber gold, and cyan blue.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"✅ Glassmorphic Layering & Depth Hierarchy","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To clearly separate multiple layers of data within a single view, the panels utilize glassmorphism effects. Elements like input boxes, tracking rows, and secondary pop-ups feature semi-transparent white fills backed by subtle background blurring. This treatment creates a distinct sense of depth, ensuring complex statistics pop sharply against the pure black background canvas.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"✅ Centralized Floating Core Navigation","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The navigational system bypasses traditional, flat tab-bars in favor of an ergonomic, persistent ","marks":[],"data":{}},{"nodeType":"text","value":"Floating Bottom Bar","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":". This control panel houses core navigation links alongside a highly visible, centered circular action button in light blue. This design element ensures primary optimization workflows remain within comfortable thumb-reach across every screen in the dashboard.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"✅ Advanced Futuristic 3D Asset Motifs","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The primary artificial intelligence portal (","marks":[],"data":{}},{"nodeType":"text","value":"Ai Assistant","marks":[{"type":"code"}],"data":{}},{"nodeType":"text","value":") elevates its visual branding by dropping a glowing, high-tech 3D holographic wireframe graphic over the interface text. This asset selection highlights the system's focus on high-performance automation, turning what could be a sterile tech portal into an engaging, premium user experience.","marks":[],"data":{}}]}]},"categories":["App Design"],"images":["https://images.ctfassets.net/7wddt967mgfr/wv5jwz3yFIKnIKKQkiDzT/af824114b28277bcf140a749906a183c/image01.jpg","https://images.ctfassets.net/7wddt967mgfr/3ZAtl9J8waYegBZNUFuz5I/e5d9436804df08fb3f21c8b2c7d39dd1/image02.jpg","https://images.ctfassets.net/7wddt967mgfr/4ToUtxviXfC5J85Q45UMBQ/8de41d6ed5f896370a2a55bb8a61ee76/image03.jpg","https://images.ctfassets.net/7wddt967mgfr/3NAyykGRJnUG6DjJg1bVLJ/d8a150ac9ef2ea83a997cf81a9fd6760/image04.jpg","https://images.ctfassets.net/7wddt967mgfr/47yRvEzywz9v6cxTyWHG1Y/25da2e1009e7cda016039acff22c4eb4/image05.jpg"],"date":"2026-06-18T00:00+08:00","updatedAt":"2026-06-18T15:55:08.648Z"}},"__N_SSG":true}