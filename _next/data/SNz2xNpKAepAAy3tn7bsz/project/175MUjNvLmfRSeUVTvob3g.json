{"pageProps":{"project":{"id":"175MUjNvLmfRSeUVTvob3g","title":"Geftshop Online Shopping Design and Development","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Geftshop","nodeType":"text"},{"data":{},"marks":[],"value":" is a modern, full‐stack e-commerce platform specializing in curated, thrifted (","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"ukay","nodeType":"text"},{"data":{},"marks":[],"value":") maxi dresses. Designed and built entirely as an independent project, I handled the complete product lifecycle—spanning UI/UX design, frontend engineering, and backend development.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The platform allows customers to seamlessly browse products, manage their shopping carts, place orders, and choose preferred payment methods (Debit Card or GCash). It also features a robust admin dashboard to manage products, monitor live inventory, process orders, and track sales performance. Tailored to the unique nature of thrifted fashion, shipping costs are dynamically calculated per order (notifying customers via automated emails), and a strict refund policy is enforced only for damaged items.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The entire system is fully secure, production-ready, and highly responsive across both desktop and mobile devices.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"\n\nCore Responsibilities & Contributions ","nodeType":"text"}],"nodeType":"heading-4"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"UI/UX & Product Design:","nodeType":"text"},{"data":{},"marks":[],"value":" Crafted the end-to-end visual identity, layout architecture, and user journeys. Focused on building an elegant, minimalist aesthetic suited for a boutique fashion brand while prioritizing an intuitive, conversion-friendly checkout flow.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Frontend Development:","nodeType":"text"},{"data":{},"marks":[],"value":" Implemented a highly responsive, component-driven user interface. Developed custom image-cropping tools for clean product presentation and integrated dynamic data visualization for the administrative dashboard.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Backend & Architecture Engineering:","nodeType":"text"},{"data":{},"marks":[],"value":" Engineered a lightweight, secure RESTful API to manage the product catalog, transaction records, and administrative workflows. Integrated third-party cloud storage solutions for media assets and decoupled state management for efficient cart handling.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"Key Product Features ","nodeType":"text"}],"nodeType":"heading-4"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Smart Product Catalog:","nodeType":"text"},{"data":{},"marks":[],"value":" Each curated piece includes detailed attributes (name, description, price, and \"On Hand / Sold Out\" stock statuses).","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"italic"}],"value":"Automated Sizing:","nodeType":"text"},{"data":{},"marks":[],"value":" Automatically calculates standard Asian Sizes (XS–4XL) based on precise manual inputs (Bust, Waist, Length).","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"italic"}],"value":"Media Management:","nodeType":"text"},{"data":{},"marks":[],"value":" Supports up to 8 high‐quality images per product, automatically cropped to a clean 4:5 portrait aspect ratio for consistent grid alignment.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"italic"}],"value":"Serialized Cataloging:","nodeType":"text"},{"data":{},"marks":[],"value":" Generates an auto-incrementing, unique ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"dressCode","nodeType":"text"},{"data":{},"marks":[],"value":" (starting at ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"1001001","nodeType":"text"},{"data":{},"marks":[],"value":") serving as the primary SKU identifier.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Frictionless Cart & Checkout:","nodeType":"text"},{"data":{},"marks":[],"value":" Customers provide standard fulfillment details (name, email, phone, and address). To eliminate third-party transaction fees and accommodate fluctuating courier rates, shipping is calculated post-purchase by the administrator. Customers select their preferred payment method (Debit Card or GCash) during checkout, and the admin coordinates direct payment after confirming the order details.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Administrative Command Center:","nodeType":"text"},{"data":{},"marks":[],"value":" A powerful, secure dashboard that allows the administrator to view all transactions, filter orders by status (","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"Pending, Approved, Shipped, Cancelled","nodeType":"text"},{"data":{},"marks":[],"value":"), adjust live inventory, and view deep customer insight logs. Every successfully placed order triggers real-time email notifications directly to the admin with full breakdown details.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"Technical Stack & Infrastructure  ","nodeType":"text"}],"nodeType":"heading-4"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Layer","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Technologies & Tools","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"}],"nodeType":"table-row"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Frontend","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"React 19, Tailwind CSS 3, React Router DOM (","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"HashRouter","nodeType":"text"},{"data":{},"marks":[],"value":" for seamless GitHub Pages routing), Swiper.js (touch-responsive carousels), Recharts (interactive dashboard analytics), React Easy Crop (client-side image processing).","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"}],"nodeType":"table-row"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Backend","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Node.js, Express.js, Multer (multipart form-data handling), Cloudinary API (cloud image hosting), JSONBin (persistent cloud JSON storage for orders and catalogs), Resend API (transactional email automation).","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"}],"nodeType":"table-row"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"State & Auth","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"React Context API (","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"CartContext","nodeType":"text"},{"data":{},"marks":[],"value":") combined with ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"localStorage ","nodeType":"text"},{"data":{},"marks":[],"value":"for persistent shopping sessions. Session-based administrator protection via secure ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"localStorage","nodeType":"text"},{"data":{},"marks":[],"value":" tokens.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"}],"nodeType":"table-row"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Deployment","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Frontend:","nodeType":"text"},{"data":{},"marks":[],"value":" GitHub Pages (Static Hosting)","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Backend:","nodeType":"text"},{"data":{},"marks":[],"value":" Render (Cloud Hosting Platform)","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Media Asset Storage:","nodeType":"text"},{"data":{},"marks":[],"value":" Cloudinary CDN","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"table-cell"}],"nodeType":"table-row"}],"nodeType":"table"},{"data":{},"content":[{"data":{},"marks":[],"value":"Project Links","nodeType":"text"}],"nodeType":